{
  "kind": "singleType",
  "collectionName": "agropulse_site_settings",
  "info": {
    "singularName": "site-setting",
    "pluralName": "site-settings",
    "displayName": "Paramètres du site"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "brandName": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "tagline": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "navigation": {
      "type": "component",
      "component": "shared.navigation-item",
      "repeatable": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "publicContact": {
      "type": "component",
      "component": "shared.public-contact",
      "repeatable": false,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "socialLinks": {
      "type": "component",
      "component": "shared.social-link",
      "repeatable": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    }
  }
}
