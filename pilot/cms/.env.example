HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Public preview address used by the visual editor (not a secret).
VITE_AGROPULSE_SITE_URL=http://127.0.0.1:4173

# Private server-to-server secret for website form intake.
# Must match AGROPULSE_FORM_INGEST_TOKEN on the public website.
AGROPULSE_FORM_INGEST_TOKEN=

# Separate private server-to-server secret for delivery-status updates.
# Must match AGROPULSE_FORM_DELIVERY_TOKEN on the public website.
AGROPULSE_FORM_DELIVERY_TOKEN=

# Database - MySQL / MariaDB (Hostinger)
DATABASE_CLIENT=mysql
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=replace_me
DATABASE_USERNAME=replace_me
DATABASE_PASSWORD=replace_me
DATABASE_SSL=false
DATABASE_POOL_MIN=0
DATABASE_POOL_MAX=5
DATABASE_CONNECTION_TIMEOUT=60000

DATABASE_POOL_IDLE_TIMEOUT=30000
DATABASE_POOL_REAP_INTERVAL=1000
