RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.agropulsegs\.org(?::\d+)?$ [NC]
RewriteRule ^ https://agropulsegs.org%{REQUEST_URI} [R=308,L,NE]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Content-Security-Policy "object-src 'none'; base-uri 'none'; frame-ancestors 'self' https://cms.agropulsegs.org; upgrade-insecure-requests"
</IfModule>
