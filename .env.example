HOST=0.0.0.0
PORT=4173

# Resend: configure these in the deployment environment, never in public files.
AGROPULSE_RECIPIENT_EMAIL=
EMAIL_FROM=
RESEND_API_KEY=

# Optional Strapi connection for published homepage text. Configure on the server only.
AGROPULSE_CMS_URL=
AGROPULSE_CMS_HOME_DOCUMENT_ID=
AGROPULSE_CMS_READ_TOKEN=

# Enable the published page copy/layout bridge after preparing real CMS entries.
AGROPULSE_CMS_ENABLE_PAGES=false
# Browser origin of the admin panel, if different from AGROPULSE_CMS_URL.
AGROPULSE_CMS_ADMIN_ORIGIN=

# Server-to-server secrets. Each token must match its counterpart in the CMS environment.
AGROPULSE_FORM_INGEST_TOKEN=
AGROPULSE_FORM_DELIVERY_TOKEN=
